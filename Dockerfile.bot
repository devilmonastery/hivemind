# Build stage
FROM golang:1.27-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS builder

# Install build dependencies
RUN apk add --no-cache git

WORKDIR /build

# Copy go mod files (root + nested api module)
COPY go.mod go.sum ./
COPY api/go.mod api/go.sum ./api/
RUN go mod download

# Copy only necessary source code for bot
COPY api/ ./api/
COPY internal/ ./internal/
COPY bot/ ./bot/

# Build the bot binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o hivemind-bot ./bot

# Runtime stage
FROM alpine:latest@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/hivemind-bot .

# Copy example config
COPY configs/example_bot.yaml ./configs/example_bot.yaml

# Run the bot
ENTRYPOINT ["./hivemind-bot"]
CMD ["run"]
