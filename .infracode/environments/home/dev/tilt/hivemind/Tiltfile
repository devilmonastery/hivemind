allow_k8s_contexts(["default", "turing"])

def cache_args(ref):
	args = ""
	if not ref:
		return args
	args += " --cache-from type=registry,ref=" + ref
	if os.getenv("TILT_CACHE_PUSH") == "1":
		args += " --cache-to type=registry,ref=" + ref + ",mode=min,image-manifest=true,oci-mediatypes=true"
	return args

def main():
	buildkit_host = os.getenv("BUILDKIT_CLUSTER_HOST", "tcp://buildkit.local.rothwell.us:1234")
	goproxy = os.getenv("GOPROXY", "https://proxy.golang.org,direct")

	k8s_yaml(kustomize("environments/home/dev/tilt/hivemind/kubernetes/hivemind"))

	k8s_resource(
		"hivemind",
		port_forwards=["4153:4153", "4163:4163"],
		labels=["app"],
		links=[link("http://localhost:4153", "grpc"), link("http://localhost:4163", "metrics")],
	)

	custom_build(
		"registry.local.rothwell.us/hivemind-server",
		"make templ css && docker buildx build" +
		" --builder=remote --platform=linux/amd64" +
		" --build-arg GOPROXY=" + goproxy +
		" -f Dockerfile --tag $EXPECTED_REF --push" + cache_args("registry.local.rothwell.us/cache/hivemind-server") +
		" .",
		deps=[
			"cmd/",
			"internal/",
			"web/templates/*.templ",
			"web/static/input.css",
			"web/static/vendor/",
			"web/static/fonts/",
			"go.mod",
			"go.sum",
			"package.json",
			"package-lock.json",
			"Dockerfile",
			"Makefile",
		],
		env={"BUILDKIT_HOST": buildkit_host},
		skips_local_docker=True,
	)
