# Repository-maintained infracode command override.
# Version is resolved from infracode/go.mod at runtime (no git ls-remote needed).
INFRACODE_LOCAL ?=
INFRACODE_GENERATOR := go run github.com/devilmonastery/infracode/cmd/generator
ifneq ($(strip $(INFRACODE_LOCAL)),)
INFRACODE_GENERATOR_ARGS := --infracode-local $(INFRACODE_LOCAL)
endif

generate:
	cd infracode && $(INFRACODE_GENERATOR) $(INFRACODE_GENERATOR_ARGS) --repo-root .. --manifest-dir infracode render

generate-check:
	cd infracode && $(INFRACODE_GENERATOR) $(INFRACODE_GENERATOR_ARGS) --repo-root .. --manifest-dir infracode check

generate-verify:
	cd infracode && $(INFRACODE_GENERATOR) $(INFRACODE_GENERATOR_ARGS) --repo-root .. --manifest-dir infracode render --verify
