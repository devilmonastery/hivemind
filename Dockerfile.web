# Build stage
FROM golang:1.27-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS builder

# Install build dependencies
RUN apk add --no-cache git

WORKDIR /build

# Copy go mod files (root + nested api module)
COPY go.mod go.sum ./
COPY api/go.mod api/go.sum ./api/
RUN go mod download

# Copy only necessary source code for web
COPY api/ ./api/
COPY internal/ ./internal/
COPY web/ ./web/

# Build the web binary with version info
ARG VERSION
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo \
    -ldflags "-X github.com/devilmonastery/hivemind/web/internal/render.Version=${VERSION}" \
    -o hivemind-web ./web

# Runtime stage
FROM alpine:latest@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/hivemind-web .

# Copy web assets
COPY web/static/ ./web/static/
COPY web/templates/ ./web/templates/

# Copy example config
COPY configs/example_web.yaml ./configs/example_web.yaml

# Expose HTTP port
EXPOSE 8080

# Run the web server
ENTRYPOINT ["./hivemind-web"]
