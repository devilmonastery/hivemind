# Build stage
FROM golang:1.27-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS builder

# Install build dependencies
RUN apk add --no-cache git

WORKDIR /build

# Copy go mod files (root + nested api module)
COPY go.mod go.sum ./
COPY api/go.mod api/go.sum ./api/
RUN go mod download

# Copy only necessary source code for web
COPY api/ ./api/
COPY internal/ ./internal/
COPY web/ ./web/

# Build the web binary with version info
ARG VERSION
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo \
    -ldflags "-X github.com/devilmonastery/hivemind/web/internal/render.Version=${VERSION}" \
    -o hivemind-web ./web

# Runtime stage
FROM alpine:latest@sha256:3f4d6b32e26703c6082839234f43769d5046b3ac7c910033911d1e71d8cd630a

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/hivemind-web .

# Copy web assets
COPY web/static/ ./web/static/
COPY web/templates/ ./web/templates/

# Copy example config
COPY configs/example_web.yaml ./configs/example_web.yaml

# Expose HTTP port
EXPOSE 8080

# Run the web server
ENTRYPOINT ["./hivemind-web"]
