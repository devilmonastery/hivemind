# Build stage
FROM golang:1.26-alpine@sha256:ce864e7223ac17b1775e6fd0b4c0db580c2eb50e7953a427916379e4b92a1628 AS builder

# Install build dependencies
RUN apk add --no-cache git

WORKDIR /build

# Copy go mod files (root + nested api module)
COPY go.mod go.sum ./
COPY api/go.mod api/go.sum ./api/
RUN go mod download

# Copy only necessary source code for server
COPY api/ ./api/
COPY internal/ ./internal/
COPY migrations/ ./migrations/
COPY server/ ./server/

# Build the server binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o hivemind-server ./server

# Runtime stage
FROM alpine:latest@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/hivemind-server .

# Copy migrations
COPY migrations/ ./migrations/

# Copy example config
COPY configs/example_server.yaml ./configs/example_server.yaml

# Expose gRPC port
EXPOSE 50051

# Run the server
ENTRYPOINT ["./hivemind-server"]
