# Build stage
FROM golang:1.27-alpine@sha256:eb61c3873c97416fff0116553fff65d67a3549f72e11d9758849a689cdd8b523 AS builder

# Install build dependencies
RUN apk add --no-cache git

WORKDIR /build

# Copy go mod files (root + nested api module)
COPY go.mod go.sum ./
COPY api/go.mod api/go.sum ./api/
RUN go mod download

# Copy only necessary source code for server
COPY api/ ./api/
COPY internal/ ./internal/
COPY migrations/ ./migrations/
COPY server/ ./server/

# Build the server binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o hivemind-server ./server

# Runtime stage
FROM alpine:latest@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/hivemind-server .

# Copy migrations
COPY migrations/ ./migrations/

# Copy example config
COPY configs/example_server.yaml ./configs/example_server.yaml

# Expose gRPC port
EXPOSE 50051

# Run the server
ENTRYPOINT ["./hivemind-server"]
