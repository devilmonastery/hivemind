# Build stage
FROM golang:1.27-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS builder

# Install build dependencies
RUN apk add --no-cache git

WORKDIR /build

# Copy go mod files (root + nested api module)
COPY go.mod go.sum ./
COPY api/go.mod api/go.sum ./api/
RUN go mod download

# Copy only necessary source code for server
COPY api/ ./api/
COPY internal/ ./internal/
COPY migrations/ ./migrations/
COPY server/ ./server/

# Build the server binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o hivemind-server ./server

# Runtime stage
FROM alpine:latest@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/hivemind-server .

# Copy migrations
COPY migrations/ ./migrations/

# Copy example config
COPY configs/example_server.yaml ./configs/example_server.yaml

# Expose gRPC port
EXPOSE 50051

# Run the server
ENTRYPOINT ["./hivemind-server"]
